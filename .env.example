# --- Zero-admin runner setup (sob gulo optional; admin panel e kichu na koreo runner chole) ---

# Builder repo (owner/repo). Na dileo DEFAULT (ei repo itself) use hoy,
# karon .github/workflows/opencode-task.yml ready-made ache.
BUILDER_REPO=td1tdcosayt1234-creator/codebridge-mcp-web

# Global GitHub token for Actions dispatch. Admin /admin/github e paste
# na korleo chole (DB token thakle DB wins).
GITHUB_TOKEN=
# (optional, GITHUB_TOKEN er specific overwrite)
# ROUN_GITHUB_TOKEN=

# Runner bearer token. Admin panel e regenerate na korleo chole —
# ei env value diyei /api/runner/next+update verify hobe.
RUNNER_TOKEN=

# Public URL of this web (Actions runner er WEB_URL secret er sathe mile)
WEB_URL=
