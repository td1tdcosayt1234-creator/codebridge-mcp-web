AUTH_SECRET=change-me-to-32chars-min-in-prod
TOKEN_ENC_KEY=change-me-to-another-32chars-key
# Public site base URL (metadata, sitemap, robots).
SITE_URL=https://roun.sryze.cc
# First-boot admin (min 12 chars; omit to auto-generate a random one, shown once in server logs)
ADMIN_EMAIL=admin@local.test
# ADMIN_PASSWORD=pick-a-strong-password-min-12-chars
# Database at-rest encryption (AES-256-GCM, min 16 chars). The whole db file
# is opaque without it. WARNING: losing/changing it makes existing data
# unreadable — back up data/db.json.bak.* AND this key together.
# DB_MASTER_KEY=pick-another-long-random-key-min-16-chars
# Optional: override JSON db path (defaults to ./data/db.json, /tmp on Vercel)
# DB_FILE=/tmp/codebridge-db.json
# Set true ONLY behind a reverse proxy that strips client-supplied
# x-forwarded-for (otherwise clients can spoof IPs past rate limits)
# TRUST_PROXY=false
# Game Studio AI generation (OpenCode Zen, OpenAI-compatible).
# Get a key at https://opencode.ai/zen — without it, /game falls back to built-in templates.
# OPENCODE_API_KEY=oc_sk_...
# Optional: override model + base URL
# OPENCODE_MODEL=opencode/gpt-5-mini
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# Paddle Billing (payments for Pro/Team). Get keys from Paddle dashboard.
# PADDLE_API_KEY=pdl_live_apikey_...
# PADDLE_PRO_PRICE_ID=pri_...
# PADDLE_TEAM_PRICE_ID=pri_...
# Optional weekly/annual prices (create matching prices in Paddle dashboard).
# PADDLE_PRO_WEEKLY_PRICE_ID=pri_...
# PADDLE_PRO_ANNUAL_PRICE_ID=pri_...
# PADDLE_TEAM_WEEKLY_PRICE_ID=pri_...
# PADDLE_TEAM_ANNUAL_PRICE_ID=pri_...
# Webhook destination: https://roun.sryze.cc/api/billing/webhook
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# Else Pay (port 3000 gateway) - merchant for CodeBridge Pro/Team.
# Create merchant in Else console (/app/console/merchants), then paste keys.
# ELSEPAY_URL=http://localhost:3000
# ELSEPAY_PUBLIC=https://elsepay.indevs.in
# ELSEPAY_SECRET=else_sk_...
# ELSEPAY_MERCHANT_ID=mer_...
# ELSEPAY_PRO_PRODUCT=else_prod_...
# ELSEPAY_TEAM_PRODUCT=else_prod_...
# Optional weekly/annual products (create in Else console merchants).
# ELSEPAY_PRO_WEEKLY_PRODUCT=else_prod_...
# ELSEPAY_PRO_ANNUAL_PRODUCT=else_prod_...
# ELSEPAY_TEAM_WEEKLY_PRODUCT=else_prod_...
# ELSEPAY_TEAM_ANNUAL_PRODUCT=else_prod_...
# Webhook destination (set as merchant webhookUrl in Else console): https://roun.sryze.cc/api/billing/elsepay/webhook
# Google login (Sign in with Google). Secrets ONLY in .env — never in JS files.
# 1) https://console.cloud.google.com/apis/credentials -> Create OAuth client (Web)
# 2) Authorized redirect URI: http://localhost:3001/api/auth/google/callback
#    + your tunnel URL: https://roun.sryze.cc/api/auth/google/callback
# 3) Paste below and restart. Works per-address: each host needs its own redirect URI entry.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# Public site URL (used for Else Pay return links + OAuth callbacks).
# MUST be reachable by the user browser — set to your tunnel URL.
# Changes every quick-tunnel restart -> update + restart dev server.
NEXT_PUBLIC_SITE_URL=https://roun.sryze.cc
# Optional: pin ONE callback URL for all hosts (must match Console exactly).
# GOOGLE_REDIRECT_URI=https://roun.sryze.cc/api/auth/google/callback
